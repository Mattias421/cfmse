# Copy to phoebe.env (untracked) and adjust paths.
export CFMSE_DATA_ROOT="${CFMSE_DATA_ROOT:-/path/to/VB+DMD}"
export CFMSE_LOG_ROOT="${CFMSE_LOG_ROOT:-/path/to/cfmse-runs}"
export CFMSE_ENV_ACTIVATE="${CFMSE_ENV_ACTIVATE:-/path/to/cfmse/bin/activate}"
export CFMSE_PYTHON="${CFMSE_PYTHON:-/path/to/cfmse/bin/python}"
