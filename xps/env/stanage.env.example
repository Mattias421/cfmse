# Copy to stanage.env (untracked) and adjust paths/module names after `module avail`
# on EL9 GPU nodes. Use a portable environment across AMD A100/H100 nodes and
# Intel H100-NVL nodes; the batch script sets the allocated GPU's CUDA arch.
export CFMSE_DATA_ROOT="${CFMSE_DATA_ROOT:-/mnt/parscratch/users/USER/data/VB+DMD}"
export CFMSE_LOG_ROOT="${CFMSE_LOG_ROOT:-/mnt/parscratch/users/USER/cfmse-runs}"
export CFMSE_ENV_ACTIVATE="${CFMSE_ENV_ACTIVATE:-/mnt/parscratch/users/USER/envs/cfmse/bin/activate}"
export CFMSE_PYTHON="${CFMSE_PYTHON:-/mnt/parscratch/users/USER/envs/cfmse/bin/python}"
export CFMSE_MODULES="${CFMSE_MODULES:-GCC/12.3.0 CUDA/12.4.0}"
# export WANDB_MODE=offline
# export CFMSE_NOLOG=1
