# Optional Stanage overrides. Normally no file is needed: runtime.sh uses
# $EXP/cfmse, $DATA/VB+DMD, $EXP/cfmse/logs, and Python through uv run. The batch
# script detects the allocated A100/H100/H100-NVL architecture.
# If nvcc is not already available on GPU nodes, set the site module names:
# export CFMSE_MODULES="GCC/12.3.0 CUDA/12.4.0"
# export WANDB_MODE=offline
# export CFMSE_NOLOG=1
